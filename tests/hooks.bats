#!/usr/bin/env bats
# The global git hooks in dotfiles/git/hooks, run by real git against a
# throwaway HOME and repository: chaining to the repository's own hooks and
# Git LFS's, and the strip and scanner switches.

setup() {
    ROOT="$(cd "${BATS_TEST_DIRNAME}/.." && pwd)"
    PC_REAL="$(command -v pre-commit 2>/dev/null || true)"   # found before PATH is narrowed
    TEST_HOME=$(mktemp -d)
    export HOME="$TEST_HOME" GIT_CONFIG_NOSYSTEM=1
    unset GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
    unset CLAUDECODE PRE_COMMIT_HOME XDG_CACHE_HOME
    HOOKS="${HOME}/.config/git/hooks"
    mkdir -p "$HOOKS" "${HOME}/stubs"
    cp -R "${ROOT}/dotfiles/git/hooks/." "$HOOKS/"
    git config --global core.hooksPath "$HOOKS"
    git config --global user.name "Example Person"
    git config --global user.email "person@work.example.com"
    git config --global init.defaultBranch main
    # gitleaks passes everything, so pre-push reaches the chaining step; no
    # Docker or scanners on PATH beyond the stubs.
    export STUB_LOG="${HOME}/stub.log"
    printf '#!/usr/bin/env bash\necho "gitleaks $1" >> "$STUB_LOG"\nexit 0\n' > "${HOME}/stubs/gitleaks"
    printf '#!/usr/bin/env bash\necho "git-lfs $*" >> "$STUB_LOG"\nwhile read -r l; do echo "git-lfs stdin: $l" >> "$STUB_LOG"; done\n' > "${HOME}/stubs/git-lfs"
    chmod 755 "${HOME}"/stubs/*
    export PATH="${HOME}/stubs:/usr/bin:/bin"
    REPO="${HOME}/repo"
    git init -q "$REPO"
    git init -q --bare "${HOME}/remote.git"
    git -C "$REPO" remote add origin "${HOME}/remote.git"
    cd "$REPO" || return 1
}

teardown() {
    cd /
    [[ -d "${TEST_HOME}/store" ]] && chmod 755 "${TEST_HOME}/store"
    rm -rf "$TEST_HOME"
}

# A repository using the pre-commit framework, with a local hook that rejects
# a staged line "BAD". The first commit runs with a writable store, which
# creates it as pre-commit would on a terminal; lock_store then makes it
# read-only, as it is in an agent sandbox.
framework() {
    [[ -n "$PC_REAL" ]] || skip "pre-commit not installed"
    ln -sf "$PC_REAL" "${HOME}/stubs/pre-commit"
    export PRE_COMMIT_HOME="${HOME}/store"
    cat > .pre-commit-config.yaml <<'EOF'
repos:
- repo: local
  hooks:
  - id: no-bad
    name: no BAD lines
    entry: bash -c '! grep -n BAD "$@"' --
    language: system
    exclude: ^\.pre-commit-config\.yaml$
EOF
    echo one > a.txt
    echo two > b.txt
    git add .pre-commit-config.yaml a.txt b.txt
    git commit -q -m init
}

lock_store() {
    chmod 555 "$PRE_COMMIT_HOME"
}

inode() {                  # FILE: rewritten files (git checkout) get a new one
    perl -e 'print +(stat shift)[1]' "$1"
}

no_patch_in_store() {
    [[ -z "$(find "$PRE_COMMIT_HOME" -name 'patch*')" ]]
}

# A plain "! cmd" line never fails a bats test (set -e ignores it).
refute_grep() {
    if grep -q "$@"; then
        echo "unexpected match: $*"
        return 1
    fi
}

repo_hook() {              # NAME BODY: the repository's own hook
    printf '#!/usr/bin/env bash\n%s\n' "$2" > "${REPO}/.git/hooks/$1"
    chmod 755 "${REPO}/.git/hooks/$1"
}

commit() {                 # MESSAGE
    git commit -q --allow-empty -m "$1"
}

@test "off by default: the repository's own hooks do not run" {
    repo_hook commit-msg 'echo "Change-Id: I123" >> "$1"'
    commit "subject"
    [[ "$(git log -1 --format=%B)" != *Change-Id* ]]
}

@test "chained, the repository's commit-msg runs after the AI trailers are stripped" {
    git config --global ns-bootstrap.chainRepoHooks true
    repo_hook commit-msg 'echo "Change-Id: I123" >> "$1"'
    commit $'subject\n\nCo-Authored-By: Claude <noreply@anthropic.com>'
    msg="$(git log -1 --format=%B)"
    [[ "$msg" == *"Change-Id: I123"* ]]
    [[ "$msg" != *Co-Authored-By* ]]
}

@test "stripAiTrailers false keeps an AI trailer" {
    git config --global ns-bootstrap.stripAiTrailers false
    commit $'subject\n\nCo-Authored-By: Claude <noreply@anthropic.com>'
    [[ "$(git log -1 --format=%B)" == *"Co-Authored-By: Claude"* ]]
}

@test "a failing repository pre-commit blocks the commit when chained" {
    git config --global ns-bootstrap.chainRepoHooks true
    repo_hook pre-commit 'echo "repo pre-commit says no" >&2; exit 1'
    run git commit -q --allow-empty -m subject
    [[ "$status" -ne 0 && "$output" == *"repo pre-commit says no"* ]]
}

@test "a pre-commit framework hook is not run twice" {
    git config --global ns-bootstrap.chainRepoHooks true
    echo 'repos: []' > .pre-commit-config.yaml
    repo_hook pre-commit $'# File generated by pre-commit: https://pre-commit.com\necho ran >> "$STUB_LOG"'
    commit subject
    refute_grep -x ran "$STUB_LOG"
}

# Agent sessions: pre-commit on the staged files only, so it never stashes
# (writing a patch into the store and checking out the whole tree).

@test "agent commit: the framework checks the staged files and leaves other unstaged files alone" {
    framework
    lock_store
    echo "one more" >> a.txt
    git add a.txt
    echo "another session's edit" >> b.txt
    before="$(inode b.txt)"
    CLAUDECODE=1 run git commit -q -m change
    [[ "$status" -eq 0 && "$output" == *"no BAD lines"*Passed* ]]
    [[ "$(git log -1 --format=%s)" == change ]]
    [[ "$(tail -1 b.txt)" == "another session's edit" && "$(inode b.txt)" == "$before" ]]
    no_patch_in_store
}

@test "agent commit: a staged file with unstaged edits too is refused, naming it" {
    framework
    lock_store
    echo "staged" >> a.txt
    git add a.txt
    echo "not staged" >> a.txt
    CLAUDECODE=1 run git commit -q -m change
    [[ "$status" -ne 0 && "$output" == *"a.txt has unstaged changes"* ]]
    [[ "$(git log -1 --format=%s)" == init ]]
    no_patch_in_store
}

@test "agent commit: a hook failing on a staged file blocks the commit" {
    framework
    lock_store
    echo BAD >> a.txt
    git add a.txt
    CLAUDECODE=1 run git commit -q -m change
    [[ "$status" -ne 0 && "$output" == *"no BAD lines"*Failed* ]]
    [[ "$(git log -1 --format=%s)" == init ]]
}

@test "agent commit: deletions only skip the framework and pass" {
    framework
    lock_store
    git rm -q b.txt
    CLAUDECODE=1 run git commit -q -m change
    [[ "$status" -eq 0 && "$output" != *"no BAD lines"* ]]
    [[ "$(git log -1 --format=%s)" == change ]]
}

@test "a read-only store alone (another agent tool) also checks the staged files only" {
    framework
    lock_store
    echo "one more" >> a.txt
    git add a.txt
    echo "another session's edit" >> b.txt
    before="$(inode b.txt)"
    run git commit -q -m change
    [[ "$status" -eq 0 && "$output" == *"no BAD lines"*Passed* ]]
    [[ "$(inode b.txt)" == "$before" ]]
    no_patch_in_store
}

@test "a terminal commit with a writable store runs pre-commit as before, stash included" {
    framework
    echo "one more" >> a.txt
    git add a.txt
    echo "unstaged edit" >> b.txt
    run git commit -q -m change
    [[ "$status" -eq 0 && "$output" == *"Stashing unstaged files"* ]]
    [[ "$(tail -1 b.txt)" == "unstaged edit" ]]
}

@test "the stubs run the repository's post-commit and post-checkout with their arguments" {
    git config --global ns-bootstrap.chainRepoHooks true
    repo_hook post-commit 'echo "post-commit" >> "$STUB_LOG"'
    repo_hook post-checkout 'echo "post-checkout $3" >> "$STUB_LOG"'
    commit subject
    git checkout -q -b other
    grep -qx post-commit "$STUB_LOG"
    grep -qx "post-checkout 1" "$STUB_LOG"
}

@test "chained, the repository's pre-push gets the same lines as ns-bootstrap's" {
    git config --global ns-bootstrap.chainRepoHooks true
    git config --global ns-bootstrap.pushScanners false
    repo_hook pre-push 'echo "repo pre-push $1" >> "$STUB_LOG"; while read -r l; do echo "repo stdin: $l" >> "$STUB_LOG"; done'
    commit subject
    run git push -q origin main
    [[ "$status" -eq 0 ]]
    [[ "$output" == *"scanners: off"* ]]
    grep -qx "repo pre-push origin" "$STUB_LOG"
    grep -q "^repo stdin: refs/heads/main $(git rev-parse HEAD) refs/heads/main 0\{40\}$" "$STUB_LOG"
}

@test "a push the secret scan blocks never reaches the repository's pre-push" {
    git config --global ns-bootstrap.chainRepoHooks true
    # Only the push-time scan (detect) fails; the commit-time one (protect) passes.
    printf '#!/usr/bin/env bash\n[ "$1" = detect ] && exit 1\nexit 0\n' > "${HOME}/stubs/gitleaks"
    repo_hook pre-push 'echo "repo pre-push" >> "$STUB_LOG"'
    commit subject
    run git push -q origin main
    [[ "$status" -ne 0 ]]
    [[ ! -e "$STUB_LOG" ]] || refute_grep -x "repo pre-push" "$STUB_LOG"
}

@test "Git LFS's pre-push runs, with the lines, in a repository with LFS objects" {
    git config --global ns-bootstrap.chainRepoHooks true
    git config --global ns-bootstrap.pushScanners false
    mkdir -p .git/lfs
    commit subject
    git push -q origin main
    grep -qx "git-lfs pre-push origin ${HOME}/remote.git" "$STUB_LOG"
    grep -q "^git-lfs stdin: refs/heads/main " "$STUB_LOG"
}

@test "LFS is not run twice when the repository's hook already calls it, nor at all without LFS objects" {
    git config --global ns-bootstrap.chainRepoHooks true
    git config --global ns-bootstrap.pushScanners false
    commit subject
    git push -q origin main
    [[ ! -e "$STUB_LOG" ]] || refute_grep "^git-lfs pre-push" "$STUB_LOG"
    mkdir -p .git/lfs
    repo_hook post-commit 'git lfs post-commit "$@"'
    commit again
    [[ "$(grep -c '^git-lfs post-commit' "$STUB_LOG")" == 1 ]]
}

@test "a repository whose hooks directory is the global one does not loop" {
    git config --global ns-bootstrap.chainRepoHooks true
    rm -rf .git/hooks
    ln -s "$HOOKS" .git/hooks
    # A loop would be hooks starting hooks, so after 10 seconds the whole
    # process group goes. perl, as older macOS has no timeout(1).
    run perl -e '$pid = fork; if (!$pid) { setpgrp(0, 0); exec @ARGV }
        $SIG{ALRM} = sub { kill "KILL", -$pid; exit 124 }; alarm 10;
        waitpid($pid, 0); exit($? >> 8)' git commit -q --allow-empty -m subject
    [[ "$status" -eq 0 ]]
}

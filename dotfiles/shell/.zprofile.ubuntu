# ─── .zprofile ─────────────────────────────────────────────────
# Runs ONCE per login session. Environment variables & PATH only.

# ─── Setup Directory ──────────────────────────────────────────
# Points to the ns-bootstrap repo. Override in ~/.zshenv if cloned elsewhere.
export NS_BOOTSTRAP_DIR="${NS_BOOTSTRAP_DIR:-${HOME}/ns-bootstrap}"

# ─── Environment Variables ─────────────────────────────────────
export EDITOR="code --wait"
export VISUAL="code --wait"
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# ─── PATH ─────────────────────────────────────────────────────
# .atuin/bin holds atuin on machines bootstrapped before it moved to
# cargo-binstall; without it the `command -v atuin` guard in .zshrc never
# fired there. New installs land in .local/bin, which comes first, so once
# update-my-system has run, the newer copy wins and the old one can go.
export PATH="${HOME}/go/bin:${HOME}/.cargo/bin:${HOME}/.local/bin:${HOME}/.atuin/bin:${HOME}/bin:${PATH}"

# ─── PATH (deduplicated) ──────────────────────────────────────
typeset -U PATH

# ─── mise (polyglot version manager for Node, Python, Ruby) ──
command -v mise &>/dev/null && eval "$(mise activate zsh)"

# ─── GPG agent TTY (required for pinentry-tty over SSH) ───────
GPG_TTY=$(tty)
export GPG_TTY
gpg-connect-agent UPDATESTARTUPTTY /bye >/dev/null 2>&1

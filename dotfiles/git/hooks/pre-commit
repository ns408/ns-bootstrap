#!/usr/bin/env bash
# Global pre-commit hook: scan staged changes for secrets, then delegate to the
# repo's own pre-commit framework if it defines one.
#
# Installed by ns-bootstrap; applies to all repositories.
# To bypass for a specific commit: git commit --no-verify

# 1. Secret scan. Warn (do not block) if gitleaks is absent so commits still
#    work on machines without it; the pre-push hook is the fail-closed backstop.
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --no-banner --redact --log-level error -v; then
        {
            echo
            echo "COMMIT BLOCKED: a secret was detected in your staged changes (finding above)."
            echo "  Fix:      git restore --staged <file>   (or move the value into .env, which is gitignored)"
            echo "  Override: git commit --no-verify         (discouraged; the pre-push hook and CI still scan)"
        } >&2
        exit 1
    fi
else
    echo "WARNING: gitleaks not found; staged changes were NOT scanned for secrets." >&2
    echo "         install it with: brew install gitleaks" >&2
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/lib/chain.sh"

# 2. Run the repo's pre-commit framework if configured. This lets per-repo hooks
#    run without each repo calling `pre-commit install` (which cannot coexist
#    with a global core.hooksPath). Fail-open: skip with a NOTE if not runnable.
if [ -f ".pre-commit-config.yaml" ]; then
    pc=""
    for c in "$PWD/.venv/bin/pre-commit" \
             "$HOME/.local/share/mise/shims/pre-commit" \
             "$(command -v pre-commit 2>/dev/null)"; do
        if [ -n "$c" ] && [ -x "$c" ] && "$c" --version >/dev/null 2>&1; then pc="$c"; break; fi
    done
    # In an agent session (CLAUDECODE), or wherever pre-commit's store exists
    # but cannot be written (an agent sandbox), check only the staged files.
    # A plain run stashes: it writes a patch into the store, which fails there,
    # and checks out the whole tree, briefly removing other sessions' unstaged
    # edits. With --files it does neither. A staged file must have no unstaged
    # changes, so the files on disk are what the commit holds.
    store="${PRE_COMMIT_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/pre-commit}"
    if [ -n "$pc" ] && { [ -n "${CLAUDECODE:-}" ] || { [ -d "$store" ] && [ ! -w "$store" ]; }; }; then
        staged=()
        while IFS= read -r -d '' f; do staged+=("$f"); done \
            < <(git diff --cached --name-only --diff-filter=ACMR -z)
        if [ "${#staged[@]}" -gt 0 ]; then
            while IFS= read -r -d '' f; do
                echo "COMMIT BLOCKED: $f has unstaged changes too; stage the whole file (git add $f) or undo the rest, then commit." >&2
                exit 1
            done < <(git diff --name-only -z -- "${staged[@]}")
            "$pc" run --config .pre-commit-config.yaml --files "${staged[@]}" || exit 1
        fi
    elif [ -n "$pc" ]; then
        "$pc" run --config .pre-commit-config.yaml || exit 1
    else
        echo "NOTE: .pre-commit-config.yaml present but pre-commit not runnable here; repo hooks skipped." >&2
    fi
fi

# 3. The repository's own pre-commit hook, with ns-bootstrap.chainRepoHooks.
chain_repo_hook pre-commit "$@" || exit $?

exit 0

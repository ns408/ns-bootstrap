#!/usr/bin/env bash
# Global pre-rebase hook: ns-bootstrap adds nothing here. It exists so that, with
# ns-bootstrap.chainRepoHooks true, the repository's own pre-rebase hook (and Git
# LFS's, where it has one) still runs under the global core.hooksPath.
# Installed by ns-bootstrap; see lib/chain.sh.

. "$(cd "$(dirname "$0")" && pwd)/lib/chain.sh"
chain_repo_hook pre-rebase "$@"

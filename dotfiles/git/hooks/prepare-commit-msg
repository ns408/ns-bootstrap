#!/usr/bin/env bash
# Global prepare-commit-msg hook: strip AI-attribution trailers before editing.
# Installed by ns-bootstrap — applies to all repositories.
# Belt-and-suspenders with commit-msg hook (which runs after editing).

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/lib/strip-ai-trailers.sh"
. "$SCRIPT_DIR/lib/chain.sh"
# Off where a repository or employer requires AI-disclosure trailers:
#   git config ns-bootstrap.stripAiTrailers false
if [ "$(git config --bool ns-bootstrap.stripAiTrailers 2>/dev/null)" != false ]; then
    strip_ai_trailers "$1"
fi
# Then the repository's own hook, so whatever it adds (a Change-Id) stays.
chain_repo_hook prepare-commit-msg "$@"
